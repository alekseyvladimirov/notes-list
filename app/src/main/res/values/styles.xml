<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NoteStyle">
        <item name="noteCornerRadius">20dp</item>
        <item name="noteElevation">5dp</item>
        <item name="noteTextColor">@color/black</item>
        <item name="noteBackgroundColor">@color/white</item>
    </style>

    <style name="NoteStyle.NotRead" parent="NoteStyle">
        <item name="noteBackgroundColor">@color/material_dynamic_neutral90</item>
    </style>

    <style name="NoteStyle.Read" parent="NoteStyle">
        <item name="noteBackgroundColor">@color/material_dynamic_neutral50</item>
    </style>
</resources>