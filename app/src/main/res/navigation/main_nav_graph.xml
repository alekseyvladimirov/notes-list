<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/notesListFragment">

    <fragment
        android:id="@+id/notesListFragment"
        android:name="com.example.noteslist.presentation.notes_list.ui.NotesListFragment"
        android:label="NotesListFragment">

        <action
            android:id="@+id/action_notesListFragment_to_noteDetailFragment"
            app:destination="@id/noteDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/noteDetailFragment"
        android:name="com.example.noteslist.presentation.note_detail.ui.NoteDetailFragment"
        android:label="NoteDetailFragment">

        <argument
            android:name="noteArgs"
            app:argType="com.example.noteslist.presentation.note_detail.model.NoteNavArgs" />
    </fragment>
</navigation>

