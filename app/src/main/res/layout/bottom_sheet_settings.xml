<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_note_stack_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/material_dynamic_primary20" />

    <TextView
        android:id="@+id/tvSpacingLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_stack_spacing"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderSpacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="4"
        android:valueTo="40" />

    <TextView
        android:id="@+id/tvMaxVisibleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_stack_max_visible"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderMaxVisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="1"
        android:valueTo="3" />

</LinearLayout>
